{
  "rules": [
    {
      "id": "ARC-LATTES",
      "title": "Currículo Lattes atualizado até a submissão",
      "layer": "PRE_SUBMISSION",
      "actor": "COORDINATOR",
      "expression": {
        "op": "EQ",
        "left": {
          "fact": "coordinator.lattes_updated"
        },
        "right": {
          "literal": true
        }
      },
      "evidence": [
        {
          "id": "EV-LAT",
          "element_id": "chamada.elm_0040",
          "quote": "ter seu currículo cadastrado na Plataforma Lattes, atualizado até a data limite para submissão da proposta"
        }
      ]
    },
