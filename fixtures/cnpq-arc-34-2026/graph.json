        "right": {
          "literal": false
        }
      },
      "evidence": [
        {
          "id": "EV-INED",
          "element_id": "chamada.elm_0050",
          "quote": "o evento objeto da proposta ainda não foi contemplado com auxílio financeiro do CNPq em outra ação de fomento"
        }
      ]
    },
    {
      "id": "ARC-INST",
      "title": "Instituição de execução no Diretório e ICT, empresa pública ou OSC",
      "layer": "PRE_SUBMISSION",
      "actor": "INSTITUTION",
      "expression": {
        "op": "ALL",
        "args": [
          {
            "op": "EQ",
            "left": {
              "fact": "institution.di_registered"
            },
            "right": {
              "literal": true
            }
          },
          {
            "op": "ANY",
            "args": [
              {
                "op": "EQ",
                "left": {
                  "fact": "institution.type"
                },
                "right": {
                  "literal": "ICT"
                }
              },
              {
                "op": "EQ",
                "left": {
                  "fact": "institution.type"
                },
                "right": {
                  "literal": "EMPRESA_PUBLICA"
                }
              },
              {
                "op": "EQ",
                "left": {
                  "fact": "institution.type"
                },
                "right": {
                  "literal": "OSC"
                }
              }
            ]
          }
        ]
      },
      "evidence": [
        {
          "id": "EV-INST",
          "element_id": "chamada.elm_0052",
          "quote": "A instituição de execução do projeto deverá estar cadastrada no Diretório de Instituições do CNPq, devendo ser uma Instituição Científica, Tecnológica e de Inovação (ICT), empresa pública ou organização da sociedade civil sem fins lucrativos"
        }
      ],
      "relation_evidence": [
        {
          "id": "EV-INST-E",
          "element_id": "chamada.elm_0052",
          "quote": "devendo ser"
        }
      ]
    },
    {
      "id": "ARC-PROMOTOR",
      "title": "Promotor é sociedade científica ou unidade de ICT",
      "layer": "PRE_SUBMISSION",
      "actor": "PROJECT",
      "expression": {
        "op": "ANY",
        "args": [
          {
            "op": "EQ",
            "left": {
              "fact": "event.promoter_type"
            },
            "right": {
              "literal": "SOCIEDADE_CIENTIFICA"
