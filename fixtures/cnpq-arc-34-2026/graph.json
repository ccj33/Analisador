          {
            "op": "EQ",
            "left": {
              "fact": "event.promoter_type"
            },
            "right": {
              "literal": "UNIDADE_ICT"
            }
          }
        ]
      },
      "evidence": [
        {
          "id": "EV-PROM",
          "element_id": "chamada.elm_0057",
          "quote": "Os eventos deverão ser promovidos por sociedades ou associações científicas e/ou tecnológicas ou unidades acadêmicas ou tecnológicas integrantes da estrutura de Instituições Científicas, Tecnológicas e de Inovação (ICTs)"
        }
      ]
    },
