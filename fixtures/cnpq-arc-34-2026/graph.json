        }
      ]
    },
    {
      "id": "ARC-INEDITO",
      "title": "Evento ainda não apoiado pelo CNPq em outra ação",
      "layer": "PRE_SUBMISSION",
      "actor": "PROJECT",
      "expression": {
        "op": "EQ",
        "left": {
          "fact": "event.already_funded_by_cnpq"
