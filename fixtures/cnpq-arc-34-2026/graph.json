    {
      "id": "ARC-ADIMPLENTE",
      "title": "Declara não ter inadimplência com CNPq e APF",
      "layer": "PRE_SUBMISSION",
      "actor": "COORDINATOR",
      "expression": {
        "op": "EQ",
