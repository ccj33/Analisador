    {
      "id": "FAP-EXEC-MG",
      "title": "Execução em Minas Gerais; fora do estado, só atividades acessórias e justificadas",
      "layer": "PRE_SUBMISSION",
      "actor": "PROJECT",
      "expression": {
        "op": "ALL",
        "args": [
          {
            "op": "EQ",
            "left": {
              "fact": "project.execution_state"
            },
            "right": {
              "literal": "MG"
            }
          },
          {
            "op": "ANY",
            "args": [
              {
                "op": "EQ",
                "left": {
                  "fact": "project.has_activities_outside_mg"
                },
                "right": {
                  "literal": false
                }
              },
              {
                "op": "ALL",
                "args": [
                  {
                    "op": "EQ",
