    {
      "id": "FAP-LIMITE",
      "title": "Uma proposta, ou até três para Desafios distintos com faturamento ≥ R$ 16 milhões",
      "layer": "PRE_SUBMISSION",
      "actor": "PROPONENT",
      "expression": {
        "op": "ANY",
        "args": [
          {
            "op": "LTE",
            "left": {
              "fact": "organization.proposals_submitted"
            },
            "right": {
              "literal": 1
            }
          },
          {
            "op": "ALL",
            "args": [
              {
                "op": "GTE",
                "left": {
                  "fact": "organization.annual_gross_revenue_mg"
                },
                "right": {
                  "literal": 16000000
                }
              },
              {
                "op": "LTE",
                "left": {
                  "fact": "organization.proposals_submitted"
                },
                "right": {
                  "literal": 3
                }
              },
              {
                "op": "EQ",
                "left": {
                  "fact": "organization.proposals_distinct_challenges"
                },
                "right": {
                  "literal": true
                }
              }
            ]
          }
        ]
      },
      "evidence": [
        {
          "id": "EV-LIM1",
          "element_id": "edital.elm_0111",
          "quote": "Cada Proponente poderá submeter 1 (uma) Proposta"
        },
        {
          "id": "EV-LIM3",
          "element_id": "edital.elm_0112",
          "quote": "faturamento bruto anual igual ou superior a R$ 16.000.000,00 (dezesseis milhões de reais) poderá submeter até 3 (três) propostas, vinculadas a Desafios distintos"
        },
        {
          "id": "EV-LIM-DES",
          "element_id": "edital.elm_0112",
          "quote": "É vedada a apresentação, pela mesma Proponente, de mais de uma Proposta para o mesmo Desafio"
        }
      ],
      "relation_evidence": [
        {
          "id": "EV-LIM-EXC",
          "element_id": "edital.elm_0111",
          "quote": "ressalvado o disposto no item 3.1.5.1"
        }
      ]
    },
